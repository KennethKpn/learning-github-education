---
// Bookmarks component (scaffold).
//
// The markup below renders during the static build. The dynamic behavior —
// adding a bookmark, generating a short slug, and persisting to the browser —
// must run ONLY in the client-side <script> boundary at the bottom of this
// file. Astro runs that script in the browser, never during the build, so
// browser-only APIs are safe there.
//
// You will implement the behavior in Step 3.
---
<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p id="bookmark-message" class="hint" role="alert" hidden></p>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<script>
  import { formatBookmark, normalizeUrl, parseStoredBookmarks } from '../lib/bookmarks.js';

  const storageKey = 'mona-bookmarks';
  const form = document.getElementById('add-bookmark');
  const urlInput = document.getElementById('url');
  const message = document.getElementById('bookmark-message');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const bookmarkList = document.getElementById('bookmark-list');
  const clearAllButton = document.getElementById('clear-all');
  const alphabet = '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz';
  let bookmarks = [];

  function showMessage(text) {
    if (!(message instanceof HTMLElement)) return;
    message.textContent = text;
    message.hidden = text.length === 0;
  }

  function renderBookmarks() {
    if (!(bookmarkList instanceof HTMLUListElement)
      || !(emptyState instanceof HTMLElement)
      || !(listHeader instanceof HTMLElement)) return;

    bookmarkList.replaceChildren();
    for (const bookmark of bookmarks) {
      const item = document.createElement('li');
      item.className = 'bookmark';
      item.setAttribute('aria-label', formatBookmark(bookmark));

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = bookmark.url;

      const separator = document.createTextNode(' :: ');
      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;

      const copyButton = document.createElement('button');
      copyButton.className = 'copy';
      copyButton.type = 'button';
      copyButton.textContent = 'Copy';
      copyButton.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          showMessage(`Copied ${bookmark.slug} to the clipboard.`);
        } catch {
          showMessage('Could not access the clipboard. Check your browser permissions and try again.');
        }
      });

      item.append(link, separator, slug, copyButton);
      bookmarkList.append(item);
    }

    const hasBookmarks = bookmarks.length > 0;
    emptyState.hidden = hasBookmarks;
    listHeader.hidden = !hasBookmarks;
    listHeader.style.display = hasBookmarks ? 'flex' : 'none';
  }

  function readBookmarks() {
    try {
      bookmarks = parseStoredBookmarks(window.localStorage.getItem(storageKey));
    } catch {
      bookmarks = [];
      showMessage('Saved bookmarks could not be read because browser storage is unavailable.');
    }
    renderBookmarks();
  }

  function saveBookmarks(nextBookmarks) {
    try {
      window.localStorage.setItem(storageKey, JSON.stringify(nextBookmarks));
      bookmarks = nextBookmarks;
      return true;
    } catch {
      showMessage('Bookmark could not be saved because browser storage is unavailable or full.');
      return false;
    }
  }

  function createUniqueSlug() {
    for (let attempt = 0; attempt < 100; attempt += 1) {
      const randomBytes = new Uint8Array(4);
      window.crypto.getRandomValues(randomBytes);
      const slug = `mona-${Array.from(randomBytes, (byte) => alphabet[byte % alphabet.length]).join('')}`;
      if (!bookmarks.some((bookmark) => bookmark.slug === slug)) return slug;
    }
    throw new Error('Could not generate a unique bookmark slug. Please try again.');
  }

  if (form instanceof HTMLFormElement && urlInput instanceof HTMLInputElement) {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      showMessage('');

      let normalizedUrl;
      try {
        normalizedUrl = normalizeUrl(urlInput.value);
      } catch (error) {
        showMessage(error instanceof Error ? error.message : 'Enter a valid HTTP or HTTPS URL.');
        return;
      }

      let slug;
      try {
        slug = createUniqueSlug();
      } catch (error) {
        showMessage(error instanceof Error ? error.message : 'Could not generate a bookmark slug.');
        return;
      }

      const nextBookmarks = [...bookmarks, { url: normalizedUrl, slug }];
      if (saveBookmarks(nextBookmarks)) {
        urlInput.value = '';
        renderBookmarks();
      }
    });
  }

  if (clearAllButton instanceof HTMLButtonElement) {
    clearAllButton.addEventListener('click', () => {
      if (!window.confirm('Clear all saved bookmarks?')) return;
      try {
        window.localStorage.removeItem(storageKey);
        bookmarks = [];
        showMessage('');
        renderBookmarks();
      } catch {
        showMessage('Bookmarks could not be cleared because browser storage is unavailable.');
      }
    });
  }

  readBookmarks();
</script>
